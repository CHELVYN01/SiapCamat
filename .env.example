# Supabase — ambil dari Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — RAHASIA, jangan pernah di-expose ke client / commit ke repo.
# Dipakai hanya di server (signed URL + verifikasi object storage).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Kuota storage yang ditampilkan di widget "Penyimpanan" (dalam GB).
# Sesuaikan dengan plan Supabase kamu: free = 1, Pro = 100.
STORAGE_QUOTA_GB=1
